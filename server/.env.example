# --- Tashqi tahdid manbalari (bo'sh qoldirilsa — o'chiq) ---
# VirusTotal: https://www.virustotal.com/gui/my-apikey
#   DIQQAT: Public API tijoriy mahsulotlarda ishlatilishi taqiqlangan (4 so'rov/daqiqa, 500/kun).
#   Ommaviy ishga tushirishda Premium kalit oling va VT_RPM / VT_RPD ni oshiring.
VT_API_KEY=
VT_RPM=4
VT_RPD=500

# abuse.ch (MalwareBazaar + URLhaus), bepul: https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# Google: web-risk (tijoriy, Google Cloud) yoki safe-browsing (faqat notijoriy)
GOOGLE_API_KEY=
GOOGLE_MODE=web-risk

# --- Server xavfsizligi ---
# Ilova yuboradigan X-Sergak-App qiymati (ilovaning sergakAppToken gradle parametri bilan bir xil)
SERGAK_APP_TOKEN=
# IOC qo'shish uchun admin token (uzun tasodifiy satr: openssl rand -hex 32)
SERGAK_ADMIN_TOKEN=
DB_PASSWORD=change-me
